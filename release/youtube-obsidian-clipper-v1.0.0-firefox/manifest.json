{
  "manifest_version": 3,
  "name": "YouTube Obsidian Clipper｜一键保存YouTube字幕",
  "version": "1.0.0",
  "description": "在 YouTube 视频页抓取字幕，预览后一键保存到 Obsidian。",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-obsidian-clipper@github.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.minimaxi.com/*",
    "https://api.moonshot.cn/*",
    "https://openrouter.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://youtu.be/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Obsidian Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "YouTube Obsidian Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_panel": "sidepanel.html",
    "open_at_install": false
  }
}
