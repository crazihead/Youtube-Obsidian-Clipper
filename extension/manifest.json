{
  "manifest_version": 3,
  "name": "YouTube Obsidian Clipper｜一键保存YouTube字幕",
  "version": "1.0.0",
  "description": "在 YouTube 视频页抓取字幕，预览后一键保存到 Obsidian。",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-obsidian-clipper@github.com",
      "strict_min_version": "109.0"
    }
  },
  
  "permissions": ["storage", "scripting", "sidePanel"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://www.googleapis.com/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://youtu.be/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Obsidian Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
